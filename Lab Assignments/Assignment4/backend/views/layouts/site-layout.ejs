<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'BeDentist - Professional dental care with modern technology.' %>">
    <title><%= typeof title !== 'undefined' ? title : 'BeDentist' %> - BeDentist</title>
    <link rel="stylesheet" href="/css/styles.css">
    <% if (typeof extraStyles !== 'undefined') { %>
        <%- extraStyles %>
    <% } %>
</head>
<body>
    <%- include('../partials/site-sidebar') %>

    <!-- Main Content -->
    <main id="main-content" class="main-content">
        <%- body %>
        
        <%- include('../partials/site-footer') %>
    </main>
</body>
</html>
