<!-- Page Header with Background Image -->
<section class="page-header-with-bg" style="background-image: url('/images/home_dentist_subheader.jpg'); background-size: cover; background-position: center; padding: 100px 0; display: flex; align-items: center; justify-content: center; min-height: 300px; position: relative;">
    <div class="container-wide" style="position: relative; z-index: 2;">
        <h1 class="page-title" style="color: #fff; font-size: 48px; text-shadow: 2px 2px 4px rgba(0,0,0,0.3); font-style: italic; font-weight: 400;">Contact</h1>
    </div>
</section>

<!-- Main Contact Section - Three Columns -->
<section style="padding: 80px 0; background: #fff;">
    <div style="display: grid; grid-template-columns: 1fr 1.2fr 320px; gap: 0; max-width: 1400px; margin: 0 auto;">
        
        <!-- Left Column - Opening Hours -->
        <div style="padding: 0 40px;">
            <h4 style="font-size: 18px; color: #4a2c4a; font-weight: 600; margin-bottom: 20px;">Opening hours</h4>
            <p style="font-size: 14px; color: #888; line-height: 1.8; margin-bottom: 30px;">Praesent ac nisi quis est vestibulum ultricies id a nisl. Pellentesque rutrum tortor in orci aliquam.</p>
            
            <!-- Opening Hours Table -->
            <table style="width: 100%; border-collapse: collapse;">
                <tr style="border-bottom: 1px solid #eee;">
                    <td style="padding: 15px 0; font-size: 14px; color: #888;">Mon-Fri</td>
                    <td style="padding: 15px 0; font-size: 14px; color: #5ccdbe; text-align: center;">10:00 a.m.</td>
                    <td style="padding: 15px 0; font-size: 14px; color: #888; text-align: right;">10:30 p.m.</td>
                </tr>
                <tr style="border-bottom: 1px solid #eee;">
                    <td style="padding: 15px 0; font-size: 14px; color: #888;">Sat</td>
                    <td style="padding: 15px 0; font-size: 14px; color: #5ccdbe; text-align: center;">11:00 a.m.</td>
                    <td style="padding: 15px 0; font-size: 14px; color: #888; text-align: right;">11:00 p.m.</td>
                </tr>
                <tr>
                    <td style="padding: 15px 0; font-size: 14px; color: #888;">Sun</td>
                    <td style="padding: 15px 0; font-size: 14px; color: #5ccdbe; text-align: center;">10:30 a.m.</td>
                    <td style="padding: 15px 0; font-size: 14px; color: #888; text-align: right;">10:00 p.m.</td>
                </tr>
            </table>
        </div>
        
        <!-- Middle Column - Contact Form -->
        <div style="padding: 0 40px;">
            <h4 style="font-size: 18px; color: #4a2c4a; font-weight: 600; margin-bottom: 25px;">Send us a message</h4>
            
            <form action="#" method="post" style="display: flex; flex-direction: column; gap: 15px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <input type="text" placeholder="Your name" style="padding: 12px 15px; border: 1px solid #e0e0e0; font-size: 14px; color: #888; background: #fff; outline: none;">
                    <input type="email" placeholder="Your e-mail" style="padding: 12px 15px; border: 1px solid #e0e0e0; font-size: 14px; color: #888; background: #fff; outline: none;">
                </div>
                <input type="text" placeholder="Subject" style="padding: 12px 15px; border: 1px solid #e0e0e0; font-size: 14px; color: #888; background: #fff; outline: none;">
                <textarea placeholder="Message" rows="5" style="padding: 12px 15px; border: 1px solid #e0e0e0; font-size: 14px; color: #888; background: #fff; outline: none; resize: vertical;"></textarea>
                <button type="submit" style="background: #4dc4b5; color: #fff; padding: 14px 35px; border: none; font-size: 14px; font-weight: 600; cursor: pointer; align-self: flex-start; transition: background 0.3s;">Send a message</button>
            </form>
        </div>
        
        <!-- Right Column - Get in Touch -->
        <div style="background-image: url('/images/home_dentist_subheader.jpg'); background-size: cover; background-position: center; padding: 40px 30px; color: #fff;">
            <h3 style="font-size: 28px; color: #fff; font-weight: 400; margin-bottom: 30px; font-style: italic;">Get in touch</h3>
            
            <!-- Location -->
            <div style="display: flex; align-items: flex-start; gap: 15px; margin-bottom: 25px;">
                <div style="width: 24px; text-align: center; padding-top: 3px;">
                    <svg width="18" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                </div>
                <div>
                    <p style="font-size: 15px; color: #fff; font-weight: 600; margin-bottom: 5px;">Envato</p>
                    <p style="font-size: 14px; color: #fff; line-height: 1.6;">Level 13, 2 Elizabeth St,<br>Melbourne, Victoria 3000<br>Australia</p>
                </div>
            </div>
            
            <!-- Phone -->
            <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 20px;">
                <div style="width: 24px; text-align: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                </div>
                <a href="tel:+61791803458" style="font-size: 14px; color: #fff; text-decoration: none;">+61 (0) 7 9180 3458</a>
            </div>
            
            <!-- Email -->
            <div style="display: flex; align-items: center; gap: 15px;">
                <div style="width: 24px; text-align: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                </div>
                <a href="mailto:noreply@envato.com" style="font-size: 14px; color: #fff; text-decoration: none;">noreply@envato.com</a>
            </div>
        </div>
    </div>
</section>

<!-- Separator Section -->
<section style="padding: 40px 0; background: #fff;">
    <div style="display: flex; align-items: center; justify-content: center; max-width: 800px; margin: 0 auto; padding: 0 40px;">
        <div style="flex: 1; height: 1px; background: #e0e0e0;"></div>
        <div style="padding: 0 30px;">
            <img src="/images/logo-tooth.png" alt="Separator" style="width: 35px; height: auto; display: block; opacity: 0.7;">
        </div>
        <div style="flex: 1; height: 1px; background: #e0e0e0;"></div>
    </div>
    <p style="text-align: center; font-size: 12px; color: #888; margin-top: 15px; letter-spacing: 2px;">BEDENT</p>
</section>
