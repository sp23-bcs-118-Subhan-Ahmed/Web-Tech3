<!-- Page Header -->
<section class="py-4" style="background: linear-gradient(135deg, #1a3a3a 0%, #0d2626 100%);">
  <div class="container text-center text-white">
    <h1 style="font-family: Georgia, serif;">Shopping Cart</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="/" class="text-white-50">Home</a></li>
        <li class="breadcrumb-item"><a href="/shop" class="text-white-50">Shop</a></li>
        <li class="breadcrumb-item active text-white" aria-current="page">Cart</li>
      </ol>
    </nav>
  </div>
</section>

<!-- Hidden element to store user login status -->
<div id="userStatus" data-logged-in="<%= typeof user !== 'undefined' && user ? 'true' : 'false' %>" style="display:none;"></div>

<section class="py-5">
  <div class="container">
    <div class="row">
      <!-- Cart Items -->
      <div class="col-md-8">
        <div class="card">
          <div class="card-header" style="background-color: #1a3a3a; color: white;">
            <i class="bi bi-cart3"></i> Cart Items
          </div>
          <div class="card-body">
            <div id="cartItems">
              <!-- Cart items will be loaded dynamically -->
              <div class="text-center py-5" id="emptyCart">
                <i class="bi bi-cart-x display-1 text-muted"></i>
                <p class="text-muted mt-3">Your cart is empty</p>
                <a href="/shop" class="btn btn-primary">Continue Shopping</a>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Order Summary -->
      <div class="col-md-4">
        <div class="card">
          <div class="card-header" style="background-color: #1a3a3a; color: white;">
            <i class="bi bi-receipt"></i> Order Summary
          </div>
          <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
              <span>Subtotal:</span>
              <span id="subtotal">$0.00</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Shipping:</span>
              <span id="shipping">$0.00</span>
            </div>
            <hr>
            <div class="d-flex justify-content-between mb-3">
              <strong>Total:</strong>
              <strong id="total" style="color: #5ccdbe;">$0.00</strong>
            </div>
            
            <button class="btn w-100 mb-2" style="background-color: #5ccdbe; color: white;" id="checkoutBtn" disabled onclick="proceedToCheckout()">
              Proceed to Checkout
            </button>
            <a href="/shop" class="btn btn-outline-secondary w-100">Continue Shopping</a>
          </div>
        </div>
        
        <!-- Promo Code -->
        <div class="card mt-3">
          <div class="card-body">
            <h6>Have a promo code?</h6>
            <div class="input-group">
              <input type="text" class="form-control" placeholder="Enter code" id="promoCode">
              <button class="btn btn-outline-secondary" type="button" onclick="applyPromo()">Apply</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
const FREE_SHIPPING_THRESHOLD = 50;
const SHIPPING_COST = 5.99;

function loadCart() {
  const cart = JSON.parse(localStorage.getItem('cart') || '[]');
  const cartItemsContainer = document.getElementById('cartItems');
  const emptyCart = document.getElementById('emptyCart');
  
  if (cart.length === 0) {
    emptyCart.style.display = 'block';
    document.getElementById('checkoutBtn').disabled = true;
    updateSummary(0);
    return;
  }
  
  emptyCart.style.display = 'none';
  document.getElementById('checkoutBtn').disabled = false;
  
  let html = '<table class="table">';
  html += '<thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Total</th><th></th></tr></thead>';
  html += '<tbody>';
  
  let subtotal = 0;
  
  cart.forEach((item, index) => {
    const itemTotal = item.price * item.quantity;
    subtotal += itemTotal;
    
    html += `
      <tr>
        <td>
          <div class="d-flex align-items-center">
            <img src="${item.image || '/images/default-product.png'}" 
                 alt="${item.name}" 
                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;" 
                 class="me-3">
            <span>${item.name}</span>
          </div>
        </td>
        <td>$${item.price.toFixed(2)}</td>
        <td>
          <div class="input-group input-group-sm" style="width: 100px;">
            <button class="btn btn-outline-secondary" type="button" onclick="updateQuantity(${index}, -1)">-</button>
            <input type="text" class="form-control text-center" value="${item.quantity}" readonly>
            <button class="btn btn-outline-secondary" type="button" onclick="updateQuantity(${index}, 1)">+</button>
          </div>
        </td>
        <td>$${itemTotal.toFixed(2)}</td>
        <td>
          <button class="btn btn-sm btn-outline-danger" onclick="removeItem(${index})">
            <i class="bi bi-trash"></i>
          </button>
        </td>
      </tr>
    `;
  });
  
  html += '</tbody></table>';
  html += '<button class="btn btn-outline-danger btn-sm" onclick="clearCart()"><i class="bi bi-trash"></i> Clear Cart</button>';
  
  cartItemsContainer.innerHTML = html;
  updateSummary(subtotal);
}

function updateSummary(subtotal) {
  const shipping = subtotal >= FREE_SHIPPING_THRESHOLD || subtotal === 0 ? 0 : SHIPPING_COST;
  const total = subtotal + shipping;
  
  document.getElementById('subtotal').textContent = '$' + subtotal.toFixed(2);
  document.getElementById('shipping').textContent = shipping === 0 ? 'FREE' : '$' + shipping.toFixed(2);
  document.getElementById('total').textContent = '$' + total.toFixed(2);
}

function updateQuantity(index, change) {
  let cart = JSON.parse(localStorage.getItem('cart') || '[]');
  cart[index].quantity += change;
  
  if (cart[index].quantity <= 0) {
    cart.splice(index, 1);
  }
  
  localStorage.setItem('cart', JSON.stringify(cart));
  loadCart();
  updateCartCount();
}

function removeItem(index) {
  let cart = JSON.parse(localStorage.getItem('cart') || '[]');
  cart.splice(index, 1);
  localStorage.setItem('cart', JSON.stringify(cart));
  loadCart();
  updateCartCount();
}

function clearCart() {
  if (confirm('Are you sure you want to clear your cart?')) {
    localStorage.removeItem('cart');
    loadCart();
    updateCartCount();
  }
}

function proceedToCheckout() {
  var userStatusEl = document.getElementById('userStatus');
  var isLoggedIn = userStatusEl && userStatusEl.getAttribute('data-logged-in') === 'true';
  if (isLoggedIn) {
    window.location.href = '/checkout';
  } else {
    alert('Please login to proceed to checkout');
    window.location.href = '/login?redirect=/checkout';
  }
}

function applyPromo() {
  const code = document.getElementById('promoCode').value;
  if (code) {
    alert('Promo code functionality coming soon!');
  }
}

// Load cart on page load
document.addEventListener('DOMContentLoaded', loadCart);
</script>



