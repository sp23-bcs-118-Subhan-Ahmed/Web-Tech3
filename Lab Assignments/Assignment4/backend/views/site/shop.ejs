<!-- Page Header -->
<section class="py-4" style="background: linear-gradient(135deg, #1a3a3a 0%, #0d2626 100%);">
  <div class="container text-center text-white">
    <h1 style="font-family: Georgia, serif;">Shop</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="/" class="text-white-50">Home</a></li>
        <li class="breadcrumb-item active text-white" aria-current="page">Shop</li>
      </ol>
    </nav>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <div class="row">
      <!-- Sidebar Filters -->
      <div class="col-md-3 mb-4">
        <div class="card">
          <div class="card-header" style="background-color: #1a3a3a; color: white;">
            <i class="bi bi-funnel"></i> Filters
          </div>
          <div class="card-body">
            <form action="/shop" method="GET">
              <!-- Search -->
              <div class="mb-3">
                <label class="form-label">Search</label>
                <input type="text" name="search" class="form-control" placeholder="Search products..." 
                       value="<%= typeof search !== 'undefined' ? search : '' %>">
              </div>
              
              <!-- Category Filter -->
              <div class="mb-3">
                <label class="form-label">Category</label>
                <select name="category" class="form-select">
                  <option value="">All Categories</option>
                  <% if(typeof categories !== 'undefined') { %>
                    <% categories.forEach(function(cat) { %>
                      <option value="<%= cat.name %>" <%= typeof selectedCategory !== 'undefined' && selectedCategory === cat.name ? 'selected' : '' %>>
                        <%= cat.name %>
                      </option>
                    <% }); %>
                  <% } %>
                </select>
              </div>
              
              <!-- Price Range -->
              <div class="mb-3">
                <label class="form-label">Price Range</label>
                <div class="row">
                  <div class="col-6">
                    <input type="number" name="minPrice" class="form-control" placeholder="Min" 
                           value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>">
                  </div>
                  <div class="col-6">
                    <input type="number" name="maxPrice" class="form-control" placeholder="Max"
                           value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>">
                  </div>
                </div>
              </div>
              
              <!-- Sort -->
              <div class="mb-3">
                <label class="form-label">Sort By</label>
                <select name="sortBy" class="form-select">
                  <option value="createdAt" <%= typeof sortBy !== 'undefined' && sortBy === 'createdAt' ? 'selected' : '' %>>Newest</option>
                  <option value="name" <%= typeof sortBy !== 'undefined' && sortBy === 'name' ? 'selected' : '' %>>Name (A-Z)</option>
                  <option value="-name" <%= typeof sortBy !== 'undefined' && sortBy === '-name' ? 'selected' : '' %>>Name (Z-A)</option>
                  <option value="price" <%= typeof sortBy !== 'undefined' && sortBy === 'price' ? 'selected' : '' %>>Price (Low to High)</option>
                  <option value="-price" <%= typeof sortBy !== 'undefined' && sortBy === '-price' ? 'selected' : '' %>>Price (High to Low)</option>
                </select>
              </div>
              
              <button type="submit" class="btn w-100" style="background-color: #5ccdbe; color: white;">
                Apply Filters
              </button>
              <a href="/shop" class="btn btn-outline-secondary w-100 mt-2">Reset</a>
            </form>
          </div>
        </div>
      </div>
      
      <!-- Products Grid -->
      <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <p class="mb-0 text-muted">
            Showing <strong><%= typeof products !== 'undefined' ? products.length : 0 %></strong> 
            of <strong><%= typeof totalProducts !== 'undefined' ? totalProducts : 0 %></strong> products
          </p>
        </div>
        
        <div class="row">
          <% if(typeof products !== 'undefined' && products.length > 0) { %>
            <% products.forEach(function(product) { %>
              <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm product-card">
                  <div class="position-relative">
                    <img src="<%= product.image || '/images/default-product.png' %>" 
                         class="card-img-top" 
                         alt="<%= product.name %>"
                         style="height: 200px; object-fit: cover;">
                    <% if(product.featured) { %>
                      <span class="badge bg-warning position-absolute top-0 end-0 m-2">Featured</span>
                    <% } %>
                  </div>
                  <div class="card-body">
                    <h5 class="card-title"><%= product.name %></h5>
                    <p class="card-text text-muted small">
                      <%= product.description ? product.description.substring(0, 80) + '...' : '' %>
                    </p>
                    <% if(product.category) { %>
                      <span class="badge bg-secondary mb-2"><%= product.category.name || product.category %></span>
                    <% } %>
                    <p class="h5 mb-0" style="color: #5ccdbe;">$<%= product.price.toFixed(2) %></p>
                  </div>
                  <div class="card-footer bg-white border-0 pb-3">
                    <button class="btn w-100 add-to-cart-btn" style="background-color: #5ccdbe; color: white;" 
                            data-id="<%= product._id %>" 
                            data-name="<%= product.name %>" 
                            data-price="<%= product.price %>" 
                            data-image="<%= product.image %>">
                      <i class="bi bi-cart-plus"></i> Add to Cart
                    </button>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="col-12 text-center py-5">
              <i class="bi bi-box-seam display-1 text-muted"></i>
              <p class="text-muted mt-3">No products found matching your criteria.</p>
              <a href="/shop" class="btn btn-primary">View All Products</a>
            </div>
          <% } %>
        </div>
        
        <!-- Pagination -->
        <% if(typeof totalPages !== 'undefined' && totalPages > 1) { %>
          <nav aria-label="Products pagination" class="mt-4">
            <ul class="pagination justify-content-center">
              <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage - 1 %>&search=<%= search || '' %>&category=<%= selectedCategory || '' %>&minPrice=<%= minPrice || '' %>&maxPrice=<%= maxPrice || '' %>&sortBy=<%= sortBy || '' %>">
                  Previous
                </a>
              </li>
              <% for(let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                  <a class="page-link" href="?page=<%= i %>&search=<%= search || '' %>&category=<%= selectedCategory || '' %>&minPrice=<%= minPrice || '' %>&maxPrice=<%= maxPrice || '' %>&sortBy=<%= sortBy || '' %>">
                    <%= i %>
                  </a>
                </li>
              <% } %>
              <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage + 1 %>&search=<%= search || '' %>&category=<%= selectedCategory || '' %>&minPrice=<%= minPrice || '' %>&maxPrice=<%= maxPrice || '' %>&sortBy=<%= sortBy || '' %>">
                  Next
                </a>
              </li>
            </ul>
          </nav>
        <% } %>
      </div>
    </div>
  </div>
</section>

<style>
.product-card {
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.product-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
}
</style>

<script>
function addToCart(id, name, price, image) {
  let cart = JSON.parse(localStorage.getItem('cart') || '[]');
  
  const existingItem = cart.find(item => item.id === id);
  if (existingItem) {
    existingItem.quantity++;
  } else {
    cart.push({ id, name, price, image, quantity: 1 });
  }
  
  localStorage.setItem('cart', JSON.stringify(cart));
  updateCartCount();
  
  // Show toast notification
  alert(name + ' added to cart!');
}

// Event delegation for add to cart buttons
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.add-to-cart-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = this.getAttribute('data-id');
      var name = this.getAttribute('data-name');
      var price = parseFloat(this.getAttribute('data-price'));
      var image = this.getAttribute('data-image');
      addToCart(id, name, price, image);
    });
  });
});
</script>



