<div class="d-flex justify-content-between align-items-center mb-4">
  <h5 class="mb-0">All Products</h5>
  <a href="/super-admin/products/create" class="btn btn-primary">
    <i class="bi bi-plus-lg"></i> Add New Product
  </a>
</div>

<div class="card">
  <div class="card-body">
    <!-- Search and Filter -->
    <form action="/super-admin/products" method="GET" class="row g-3 mb-4">
      <div class="col-md-4">
        <input type="text" name="search" class="form-control" placeholder="Search products..." 
               value="<%= typeof search !== 'undefined' ? search : '' %>">
      </div>
      <div class="col-md-3">
        <select name="category" class="form-select">
          <option value="">All Categories</option>
          <% if(typeof categories !== 'undefined') { %>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat %>" <%= typeof selectedCategory !== 'undefined' && selectedCategory === cat ? 'selected' : '' %>>
                <%= cat %>
              </option>
            <% }); %>
          <% } %>
        </select>
      </div>
      <div class="col-md-2">
        <select name="sortBy" class="form-select">
          <option value="createdAt" <%= typeof sortBy !== 'undefined' && sortBy === 'createdAt' ? 'selected' : '' %>>Newest</option>
          <option value="name" <%= typeof sortBy !== 'undefined' && sortBy === 'name' ? 'selected' : '' %>>Name</option>
          <option value="price" <%= typeof sortBy !== 'undefined' && sortBy === 'price' ? 'selected' : '' %>>Price</option>
        </select>
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary me-2">
          <i class="bi bi-search"></i> Filter
        </button>
        <a href="/super-admin/products" class="btn btn-secondary">Reset</a>
      </div>
    </form>
    
    <!-- Products Table -->
    <div class="table-responsive">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(typeof products !== 'undefined' && products.length > 0) { %>
            <% products.forEach(function(product) { %>
              <tr>
                <td>
                  <img src="<%= product.image || '/images/default-product.png' %>" 
                       alt="<%= product.name %>" 
                       style="width: 50px; height: 50px; object-fit: cover;" 
                       class="rounded">
                </td>
                <td><%= product.name %></td>
                <td>
                  <% if(product.category) { %>
                    <span class="badge bg-secondary"><%= product.category.name || product.category %></span>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td>$<%= product.price.toFixed(2) %></td>
                <td>
                  <% if(typeof product.stock !== 'undefined') { %>
                    <span class="badge bg-<%= product.stock > 10 ? 'success' : product.stock > 0 ? 'warning' : 'danger' %>">
                      <%= product.stock %>
                    </span>
                  <% } else { %>
                    <span class="text-muted">N/A</span>
                  <% } %>
                </td>
                <td>
                  <a href="/super-admin/products/edit/<%= product._id %>" class="btn btn-sm btn-outline-primary" title="Edit">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <form action="/super-admin/products/delete/<%= product._id %>" method="POST" class="d-inline" 
                        onsubmit="return confirm('Are you sure you want to delete this product?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center text-muted py-4">No products found</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    
    <!-- Pagination -->
    <% if(typeof totalPages !== 'undefined' && totalPages > 1) { %>
      <nav aria-label="Products pagination">
        <ul class="pagination justify-content-center">
          <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= currentPage - 1 %>&search=<%= search || '' %>&category=<%= selectedCategory || '' %>">Previous</a>
          </li>
          <% for(let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
              <a class="page-link" href="?page=<%= i %>&search=<%= search || '' %>&category=<%= selectedCategory || '' %>"><%= i %></a>
            </li>
          <% } %>
          <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="?page=<%= currentPage + 1 %>&search=<%= search || '' %>&category=<%= selectedCategory || '' %>">Next</a>
          </li>
        </ul>
      </nav>
    <% } %>
  </div>
</div>



