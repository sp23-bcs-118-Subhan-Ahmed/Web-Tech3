<div class="d-flex justify-content-between align-items-center mb-4">
  <h5 class="mb-0">Users</h5>
  <a href="/super-admin/users/create" class="btn btn-primary">
    <i class="bi bi-person-plus"></i> Create New Admin
  </a>
</div>

<% if(typeof req !== 'undefined' && req.query && req.query.success) { %>
  <div class="alert alert-success alert-dismissible fade show">
    <i class="bi bi-check-circle"></i> <%= req.query.success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if(typeof req !== 'undefined' && req.query && req.query.error) { %>
  <div class="alert alert-danger alert-dismissible fade show">
    <i class="bi bi-exclamation-circle"></i> <%= req.query.error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Security</th>
            <th>Phone</th>
            <th>Role</th>
            <th>Registered</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if(typeof users !== 'undefined' && users.length > 0) { %>
            <% users.forEach(function(u, index) { %>
              <tr>
                <td><%= index + 1 %></td>
                <td>
                  <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2" 
                         style="width: 35px; height: 35px; font-size: 14px;">
                      <%= u.name ? u.name.charAt(0).toUpperCase() : '?' %>
                    </div>
                    <%= u.name || 'N/A' %>
                    <% if(u.email === 'admin@bedentist.com') { %>
                      <span class="badge bg-warning text-dark ms-2" title="Super Admin - Cannot be deleted">
                        <i class="bi bi-star-fill"></i> Super
                      </span>
                    <% } %>
                  </div>
                </td>
                <td><%= u.email %></td>
                <td>
                  <span class="badge bg-success" title="Password is securely encrypted with bcrypt">
                    <i class="bi bi-shield-lock-fill"></i> Encrypted
                  </span>
                  <% if(u.googleId) { %>
                    <span class="badge bg-info ms-1" title="Logged in via Google">
                      <i class="bi bi-google"></i> OAuth
                    </span>
                  <% } %>
                </td>
                <td><%= u.phone || '-' %></td>
                <td>
                  <span class="badge bg-<%= u.isAdmin ? 'danger' : 'secondary' %>">
                    <%= u.isAdmin ? 'Admin' : 'Customer' %>
                  </span>
                </td>
                <td><%= u.createdAt ? new Date(u.createdAt).toLocaleDateString() : '-' %></td>
                <td>
                  <% if(typeof isSuperAdmin !== 'undefined' && isSuperAdmin && u.email !== 'admin@bedentist.com') { %>
                    <button type="button" class="btn btn-sm btn-outline-primary" title="Reset Password"
                            onclick="openResetPasswordModal('<%= u._id %>', '<%= u.name %>')">
                      <i class="bi bi-key"></i>
                    </button>
                  <% } %>
                  <% if(!u.isAdmin) { %>
                    <form action="/super-admin/users/toggle-admin/<%= u._id %>" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-outline-warning" title="Make Admin">
                        <i class="bi bi-shield-plus"></i>
                      </button>
                    </form>
                  <% } %>
                  <% if(u._id.toString() !== user.id && u.email !== 'admin@bedentist.com') { %>
                    <form action="/super-admin/users/delete/<%= u._id %>" method="POST" class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this user?');">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center text-muted py-4">No users found</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Stats -->
<div class="row mt-4">
  <div class="col-md-4">
    <div class="card text-center">
      <div class="card-body">
        <h3 class="text-primary"><%= typeof users !== 'undefined' ? users.length : 0 %></h3>
        <p class="text-muted mb-0">Total Users</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-center">
      <div class="card-body">
        <h3 class="text-danger"><%= typeof users !== 'undefined' ? users.filter(u => u.isAdmin).length : 0 %></h3>
        <p class="text-muted mb-0">Admins</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-center">
      <div class="card-body">
        <h3 class="text-success"><%= typeof users !== 'undefined' ? users.filter(u => !u.isAdmin).length : 0 %></h3>
        <p class="text-muted mb-0">Customers</p>
      </div>
    </div>
  </div>
</div>

<% if(typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-key"></i> Reset Password</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="resetPasswordForm" method="POST">
        <div class="modal-body">
          <p>Resetting password for: <strong id="resetUserName"></strong></p>
          <div class="mb-3">
            <label for="newPassword" class="form-label">New Password</label>
            <div class="input-group">
              <input type="password" class="form-control" id="newPassword" name="newPassword" 
                     required minlength="6" placeholder="Enter new password">
              <button class="btn btn-outline-secondary" type="button" onclick="toggleNewPassword()">
                <i class="bi bi-eye" id="newPwdIcon"></i>
              </button>
            </div>
          </div>
          <div class="mb-3">
            <label for="confirmNewPassword" class="form-label">Confirm Password</label>
            <div class="input-group">
              <input type="password" class="form-control" id="confirmNewPassword" name="confirmNewPassword" 
                     required minlength="6" placeholder="Confirm new password">
              <button class="btn btn-outline-secondary" type="button" onclick="toggleConfirmPassword()">
                <i class="bi bi-eye" id="confirmPwdIcon"></i>
              </button>
            </div>
            <div id="passwordMatchError" class="text-danger small mt-1" style="display:none;">
              Passwords do not match!
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="resetBtn">
            <i class="bi bi-check-lg"></i> Reset Password
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function togglePasswordView(userId, password) {
    const pwdSpan = document.getElementById('pwd-' + userId);
    const eyeIcon = document.getElementById('eye-' + userId);
    
    if (pwdSpan.innerText === '••••••••') {
      pwdSpan.innerText = password;
      eyeIcon.classList.remove('bi-eye');
      eyeIcon.classList.add('bi-eye-slash');
    } else {
      pwdSpan.innerText = '••••••••';
      eyeIcon.classList.remove('bi-eye-slash');
      eyeIcon.classList.add('bi-eye');
    }
  }
  
  function openResetPasswordModal(userId, userName) {
    document.getElementById('resetUserName').innerText = userName;
    document.getElementById('resetPasswordForm').action = '/super-admin/users/reset-password/' + userId;
    document.getElementById('newPassword').value = '';
    document.getElementById('confirmNewPassword').value = '';
    document.getElementById('passwordMatchError').style.display = 'none';
    var modal = new bootstrap.Modal(document.getElementById('resetPasswordModal'));
    modal.show();
  }
  
  function toggleNewPassword() {
    var input = document.getElementById('newPassword');
    var icon = document.getElementById('newPwdIcon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.remove('bi-eye');
      icon.classList.add('bi-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.remove('bi-eye-slash');
      icon.classList.add('bi-eye');
    }
  }
  
  function toggleConfirmPassword() {
    var input = document.getElementById('confirmNewPassword');
    var icon = document.getElementById('confirmPwdIcon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.remove('bi-eye');
      icon.classList.add('bi-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.remove('bi-eye-slash');
      icon.classList.add('bi-eye');
    }
  }
  
  // Validate passwords match
  document.getElementById('confirmNewPassword').addEventListener('input', function() {
    var pwd = document.getElementById('newPassword').value;
    var confirmPwd = this.value;
    var errorDiv = document.getElementById('passwordMatchError');
    if (confirmPwd && pwd !== confirmPwd) {
      errorDiv.style.display = 'block';
    } else {
      errorDiv.style.display = 'none';
    }
  });
  
  document.getElementById('resetPasswordForm').addEventListener('submit', function(e) {
    var pwd = document.getElementById('newPassword').value;
    var confirmPwd = document.getElementById('confirmNewPassword').value;
    if (pwd !== confirmPwd) {
      e.preventDefault();
      document.getElementById('passwordMatchError').style.display = 'block';
      return false;
    }
  });
</script>
<% } %>
