<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login - BeDentist</title>
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      min-height: 100vh;
      display: flex;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    
    .login-container {
      display: flex;
      width: 100%;
      min-height: 100vh;
    }
    
    /* Left Side - Branding */
    .brand-side {
      flex: 1;
      background: linear-gradient(135deg, #1a3a3a 0%, #0d2626 100%);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 40px;
      color: white;
      position: relative;
      overflow: hidden;
    }
    
    .brand-side::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(92, 205, 190, 0.1) 0%, transparent 50%);
      animation: pulse 15s infinite;
    }
    
    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.1); }
    }
    
    .brand-content {
      position: relative;
      z-index: 1;
      text-align: center;
    }
    
    .brand-logo {
      font-family: 'Lora', Georgia, serif;
      font-size: 3.5rem;
      font-weight: 700;
      margin-bottom: 10px;
    }
    
    .brand-logo i {
      color: #5ccdbe;
      margin-right: 10px;
    }
    
    .brand-tagline {
      font-size: 1.2rem;
      opacity: 0.9;
      margin-bottom: 40px;
    }
    
    .brand-features {
      text-align: left;
      max-width: 350px;
    }
    
    .brand-feature {
      display: flex;
      align-items: center;
      margin-bottom: 20px;
      padding: 15px;
      background: rgba(255,255,255,0.1);
      border-radius: 10px;
      transition: transform 0.3s;
    }
    
    .brand-feature:hover {
      transform: translateX(10px);
    }
    
    .brand-feature i {
      font-size: 1.5rem;
      color: #5ccdbe;
      margin-right: 15px;
    }
    
    .brand-feature-text h4 {
      font-size: 1rem;
      margin-bottom: 5px;
    }
    
    .brand-feature-text p {
      font-size: 0.85rem;
      opacity: 0.8;
      margin: 0;
    }
    
    /* Right Side - Login Form */
    .form-side {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 40px;
      background: #f8f9fa;
    }
    
    .login-form-container {
      width: 100%;
      max-width: 400px;
    }
    
    .login-header {
      margin-bottom: 40px;
    }
    
    .login-header h2 {
      font-family: 'Lora', Georgia, serif;
      font-size: 2rem;
      color: #1a3a3a;
      margin-bottom: 10px;
    }
    
    .login-header p {
      color: #666;
    }
    
    .login-form .form-label {
      font-weight: 500;
      color: #333;
    }
    
    .login-form .form-control {
      padding: 12px 15px;
      border: 2px solid #e0e0e0;
      border-radius: 10px;
      transition: all 0.3s;
    }
    
    .login-form .form-control:focus {
      border-color: #1a3a3a;
      box-shadow: 0 0 0 3px rgba(26, 58, 58, 0.1);
    }
    
    .input-group-text {
      background: transparent;
      border: 2px solid #e0e0e0;
      border-right: none;
      border-radius: 10px 0 0 10px;
    }
    
    .input-group .form-control {
      border-left: none;
      border-radius: 0 10px 10px 0;
    }
    
    .input-group:focus-within .input-group-text {
      border-color: #1a3a3a;
    }
    
    .btn-login {
      width: 100%;
      padding: 12px;
      background: linear-gradient(135deg, #1a3a3a 0%, #0d2626 100%);
      border: none;
      border-radius: 10px;
      color: white;
      font-weight: 600;
      font-size: 1rem;
      transition: all 0.3s;
    }
    
    .btn-login:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 20px rgba(26, 58, 58, 0.4);
    }
    
    .admin-badge {
      display: inline-flex;
      align-items: center;
      background: linear-gradient(135deg, #1a3a3a 0%, #0d2626 100%);
      color: white;
      padding: 5px 15px;
      border-radius: 20px;
      font-size: 0.85rem;
      margin-bottom: 20px;
    }
    
    .admin-badge i {
      margin-right: 8px;
    }
    
    .back-link {
      display: inline-flex;
      align-items: center;
      color: #666;
      text-decoration: none;
      margin-top: 30px;
      transition: color 0.3s;
    }
    
    .back-link:hover {
      color: #1a3a3a;
    }
    
    .back-link i {
      margin-right: 8px;
    }
    
    .alert {
      border-radius: 10px;
      padding: 15px;
    }
    
    /* Responsive */
    @media (max-width: 992px) {
      .login-container {
        flex-direction: column;
      }
      
      .brand-side {
        padding: 40px 20px;
        min-height: auto;
      }
      
      .brand-features {
        display: none;
      }
      
      .brand-logo {
        font-size: 2.5rem;
      }
    }
  </style>
</head>
<body>
  <div class="login-container">
    <!-- Left Side - Branding -->
    <div class="brand-side">
      <div class="brand-content">
        <div class="brand-logo">
          <i class="bi bi-shield-lock-fill"></i>
          BeDentist
        </div>
        <p class="brand-tagline">Admin Control Panel</p>
        
        <div class="brand-features">
          <div class="brand-feature">
            <i class="bi bi-box-seam"></i>
            <div class="brand-feature-text">
              <h4>Product Management</h4>
              <p>Add, edit, and manage all products</p>
            </div>
          </div>
          <div class="brand-feature">
            <i class="bi bi-receipt"></i>
            <div class="brand-feature-text">
              <h4>Order Tracking</h4>
              <p>Monitor and update order statuses</p>
            </div>
          </div>
          <div class="brand-feature">
            <i class="bi bi-people"></i>
            <div class="brand-feature-text">
              <h4>User Management</h4>
              <p>View and manage customer accounts</p>
            </div>
          </div>
          <div class="brand-feature">
            <i class="bi bi-graph-up"></i>
            <div class="brand-feature-text">
              <h4>Analytics Dashboard</h4>
              <p>Track sales and performance</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Right Side - Login Form -->
    <div class="form-side">
      <div class="login-form-container">
        <div class="admin-badge">
          <i class="bi bi-shield-check"></i>
          Admin Access Only
        </div>
        
        <div class="login-header">
          <h2>Welcome Back</h2>
          <p>Sign in to access the admin dashboard</p>
        </div>
        
        <% if(typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger mb-4">
            <i class="bi bi-exclamation-circle me-2"></i>
            <%= error %>
          </div>
        <% } %>
        
        <% if(typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success mb-4">
            <i class="bi bi-check-circle me-2"></i>
            <%= success %>
          </div>
        <% } %>
        
        <form action="/super-admin/login" method="POST" class="login-form">
          <div class="mb-4">
            <label for="email" class="form-label">Email Address</label>
            <div class="input-group">
              <span class="input-group-text">
                <i class="bi bi-envelope"></i>
              </span>
              <input type="email" class="form-control" id="email" name="email" 
                     placeholder="admin@example.com" required
                     value="<%= typeof email !== 'undefined' ? email : '' %>">
            </div>
          </div>
          
          <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <div class="input-group">
              <span class="input-group-text">
                <i class="bi bi-lock"></i>
              </span>
              <input type="password" class="form-control" id="password" name="password" 
                     placeholder="••••••••" required>
            </div>
          </div>
          
          <button type="submit" class="btn btn-login">
            <i class="bi bi-box-arrow-in-right me-2"></i>
            Sign In to Dashboard
          </button>
        </form>
        
        <a href="/" class="back-link">
          <i class="bi bi-arrow-left"></i>
          Back to Website
        </a>
      </div>
    </div>
  </div>
  
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
