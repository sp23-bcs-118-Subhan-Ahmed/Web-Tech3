<style>
    .track-header {
        background: linear-gradient(135deg, #5ccdbe 0%, #3ba99a 100%);
        color: white;
        padding: 60px 40px;
        text-align: center;
        border-radius: 0 0 30px 30px;
    }
    
    .track-header h1 {
        font-size: 36px;
        margin: 0 0 10px;
    }
    
    .track-header p {
        margin: 0;
        opacity: 0.9;
    }
    
    .track-container {
        max-width: 700px;
        margin: -30px auto 40px;
        padding: 0 20px;
    }
    
    .track-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        overflow: hidden;
    }
    
    .track-form-section {
        padding: 40px;
        background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
    }
    
    .search-box {
        display: flex;
        gap: 15px;
        background: white;
        padding: 8px;
        border-radius: 50px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }
    
    .search-box input {
        flex: 1;
        border: none;
        padding: 15px 25px;
        font-size: 16px;
        border-radius: 50px;
        outline: none;
    }
    
    .search-box button {
        padding: 15px 40px;
        background: linear-gradient(135deg, #5ccdbe 0%, #3ba99a 100%);
        color: white;
        border: none;
        border-radius: 50px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }
    
    .search-box button:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(92, 205, 190, 0.4);
    }
    
    .order-result {
        display: none;
        padding: 30px;
        border-top: 1px solid #eee;
    }
    
    .order-result.active {
        display: block;
    }
    
    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 1px solid #eee;
    }
    
    .order-number-display {
        font-size: 22px;
        font-weight: 700;
        color: #333;
    }
    
    .status-badge {
        padding: 8px 20px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 14px;
        text-transform: capitalize;
    }
    
    .status-pending { background: #fff3e0; color: #ff9800; }
    .status-confirmed { background: #e3f2fd; color: #2196f3; }
    .status-processing { background: #f3e5f5; color: #9c27b0; }
    .status-shipped { background: #e0f7fa; color: #00bcd4; }
    .status-delivered { background: #e8f5e9; color: #4caf50; }
    .status-cancelled { background: #ffebee; color: #f44336; }
    
    .order-details {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }
    
    .detail-item {
        padding: 15px;
        background: #f8f9fa;
        border-radius: 12px;
    }
    
    .detail-item label {
        display: block;
        color: #888;
        font-size: 12px;
        margin-bottom: 5px;
        text-transform: uppercase;
    }
    
    .detail-item span {
        font-weight: 600;
        color: #333;
        font-size: 15px;
    }
    
    .tracking-timeline {
        margin-top: 30px;
    }
    
    .tracking-timeline h3 {
        margin-bottom: 20px;
        color: #333;
    }
    
    .timeline {
        position: relative;
        padding-left: 10px;
    }
    
    .timeline::before {
        content: '';
        position: absolute;
        left: 20px;
        top: 0;
        bottom: 0;
        width: 3px;
        background: linear-gradient(to bottom, #5ccdbe 0%, #e0e0e0 100%);
        border-radius: 3px;
    }
    
    .timeline-item {
        position: relative;
        padding-left: 60px;
        padding-bottom: 30px;
        display: flex;
        align-items: flex-start;
    }
    
    .timeline-item:last-child {
        padding-bottom: 0;
    }
    
    .timeline-icon {
        position: absolute;
        left: 5px;
        top: 0;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        border: 3px solid #e0e0e0;
        z-index: 1;
    }
    
    .timeline-item.completed .timeline-icon {
        border-color: #5ccdbe;
        background: #e8f8f6;
    }
    
    .timeline-item.current .timeline-icon {
        border-color: #5ccdbe;
        background: #5ccdbe;
        box-shadow: 0 0 0 4px rgba(92, 205, 190, 0.3);
    }
    
    .timeline-item.pending .timeline-icon {
        border-color: #e0e0e0;
        background: #f5f5f5;
        opacity: 0.6;
    }
    
    .timeline-content {
        flex: 1;
        padding: 12px 15px;
        border-radius: 10px;
        margin-left: 10px;
        background: #f8f9fa;
        transition: all 0.3s;
    }
    
    .timeline-item.completed .timeline-content {
        background: linear-gradient(135deg, #e8f8f6 0%, #d4f4ef 100%);
        border-left: 3px solid #5ccdbe;
    }
    
    .timeline-item.current .timeline-content {
        background: linear-gradient(135deg, #5ccdbe 0%, #3ba99a 100%);
        border-left: 3px solid #2d8a7c;
        box-shadow: 0 5px 20px rgba(92, 205, 190, 0.3);
    }
    
    .timeline-item.current .status,
    .timeline-item.current .message {
        color: white !important;
    }
    
    .timeline-item.current .time {
        color: rgba(255,255,255,0.85) !important;
    }
    
    .timeline-item.pending .timeline-content {
        background: #f5f5f5;
        border-left: 3px solid #e0e0e0;
        opacity: 0.6;
    }
    
    .timeline-item .status {
        font-weight: 600;
        color: #333;
        margin-bottom: 4px;
        font-size: 15px;
    }
    
    .timeline-item.pending .status {
        color: #999;
    }
    
    .timeline-item .message {
        color: #666;
        font-size: 13px;
        margin-bottom: 4px;
    }
    
    .timeline-item.pending .message {
        color: #bbb;
    }
    
    .timeline-item .time {
        color: #5ccdbe;
        font-size: 12px;
        font-weight: 500;
    }
    
    .error-message {
        text-align: center;
        padding: 40px;
        color: #721c24;
        background: #f8d7da;
        border-radius: 10px;
        margin-top: 20px;
    }
    
    .error-message h3 {
        margin: 0 0 10px;
    }
    
    @media (max-width: 600px) {
        .search-box {
            flex-direction: column;
        }
        
        .order-details {
            grid-template-columns: 1fr;
        }
        
        .order-header {
            flex-direction: column;
            text-align: center;
        }
    }
</style>

<!-- Track Header -->
<div class="track-header">
    <h1>📍 Track Your Order</h1>
    <p>Enter your order number to see the status of your order</p>
</div>

<div class="track-container">
    <div class="track-card">
        <div class="track-form-section">
            <div class="search-box">
                <input type="text" id="orderNumberInput" placeholder="Enter Order Number (e.g., BD2512XXXX)" maxlength="15">
                <button onclick="trackOrder()" id="trackBtn">Track</button>
            </div>
        </div>
        
        <div id="orderResult" class="order-result">
            <!-- Order details will be loaded here -->
        </div>
        
        <div id="errorResult" class="order-result">
            <!-- Error message will be shown here -->
        </div>
    </div>
</div>

<script>
    const API_URL = 'http://localhost:5000/api';

    // Allow Enter key to search
    document.getElementById('orderNumberInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') trackOrder();
    });

    async function trackOrder() {
        const orderNumber = document.getElementById('orderNumberInput').value.trim().toUpperCase();
        
        if (!orderNumber) {
            alert('Please enter an order number');
            return;
        }
        
        const btn = document.getElementById('trackBtn');
        btn.disabled = true;
        btn.textContent = 'Tracking...';
        
        try {
            const response = await fetch(`${API_URL}/orders/track/${orderNumber}`);
            const data = await response.json();
            
            if (data.success) {
                showOrderResult(data.data);
            } else {
                showError(data.message);
            }
        } catch (error) {
            console.error('Error:', error);
            showError('Unable to track order. Please try again later.');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Track';
        }
    }

    function showOrderResult(order) {
        document.getElementById('errorResult').classList.remove('active');
        
        // Define all possible statuses in order
        const allStatuses = ['pending', 'confirmed', 'processing', 'shipped', 'delivered'];
        const currentStatusIndex = allStatuses.indexOf(order.orderStatus);
        
        const resultDiv = document.getElementById('orderResult');
        resultDiv.innerHTML = `
            <div class="order-header">
                <span class="order-number-display">${order.orderNumber}</span>
                <span class="status-badge status-${order.orderStatus}">${formatStatus(order.orderStatus)}</span>
            </div>
            
            <div class="order-details">
                <div class="detail-item">
                    <label>Product</label>
                    <span>${order.productName}</span>
                </div>
                <div class="detail-item">
                    <label>Quantity</label>
                    <span>${order.quantity}</span>
                </div>
                <div class="detail-item">
                    <label>Amount</label>
                    <span>Rs. ${order.amount.toLocaleString()}</span>
                </div>
                <div class="detail-item">
                    <label>Order Date</label>
                    <span>${formatDate(order.createdAt)}</span>
                </div>
                ${order.trackingNumber ? `
                <div class="detail-item">
                    <label>Tracking Number</label>
                    <span>${order.trackingNumber}</span>
                </div>
                ` : ''}
                ${order.estimatedDelivery ? `
                <div class="detail-item">
                    <label>Estimated Delivery</label>
                    <span>${formatDate(order.estimatedDelivery)}</span>
                </div>
                ` : ''}
            </div>
            
            <div class="tracking-timeline">
                <h3>📦 Order Timeline</h3>
                <div class="timeline">
                    ${allStatuses.map((status, index) => {
                        const isCompleted = index <= currentStatusIndex;
                        const isCurrent = index === currentStatusIndex;
                        const historyItem = order.trackingHistory ? order.trackingHistory.find(h => h.status === status) : null;
                        const statusIcons = {
                            'pending': '🕐',
                            'confirmed': '✅',
                            'processing': '⚙️',
                            'shipped': '🚚',
                            'delivered': '📬'
                        };
                        const statusMessages = {
                            'pending': 'Order placed successfully',
                            'confirmed': 'Order has been confirmed',
                            'processing': 'Order is being prepared',
                            'shipped': 'Order has been shipped',
                            'delivered': 'Order delivered successfully'
                        };
                        
                        return `
                            <div class="timeline-item ${isCompleted ? 'completed' : 'pending'} ${isCurrent ? 'current' : ''}">
                                <div class="timeline-icon">${isCompleted ? statusIcons[status] : '⭕'}</div>
                                <div class="timeline-content">
                                    <div class="status">${formatStatus(status)}</div>
                                    <div class="message">${historyItem ? historyItem.message : statusMessages[status]}</div>
                                    ${historyItem ? `<div class="time">${formatDateTime(historyItem.timestamp)}</div>` : ''}
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            </div>
        `;
        resultDiv.classList.add('active');
    }

    function showError(message) {
        document.getElementById('orderResult').classList.remove('active');
        
        const errorDiv = document.getElementById('errorResult');
        errorDiv.innerHTML = `
            <div class="error-message">
                <h3>❌ Order Not Found</h3>
                <p>${message}</p>
            </div>
        `;
        errorDiv.classList.add('active');
    }

    function formatStatus(status) {
        const statusMap = {
            'pending': 'Pending',
            'confirmed': 'Confirmed',
            'processing': 'Processing',
            'shipped': 'Shipped',
            'delivered': 'Delivered',
            'cancelled': 'Cancelled'
        };
        return statusMap[status] || status;
    }

    function formatDate(dateStr) {
        const date = new Date(dateStr);
        return date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });
    }

    function formatDateTime(dateStr) {
        const date = new Date(dateStr);
        return date.toLocaleString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
    }

    // Auto-track if orderNumber is in URL
    document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        const orderNumber = urlParams.get('orderNumber');
        if (orderNumber) {
            document.getElementById('orderNumberInput').value = orderNumber;
            trackOrder();
        }
    });
</script>
