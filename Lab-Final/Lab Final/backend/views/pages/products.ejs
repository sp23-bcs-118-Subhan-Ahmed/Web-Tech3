<style>
    .products-page {
        padding: 40px 0 80px;
        background: #f8f8f8;
        min-height: 100vh;
    }
    
    .products-header {
        background-image: url('/images/home_dentist_subheader.jpg');
        background-size: cover;
        background-position: center;
        padding: 100px 0;
        text-align: center;
        color: white;
        margin-bottom: 40px;
        min-height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
    }
    
    .products-header h1 {
        font-size: 42px;
        margin-bottom: 10px;
    }
    
    .products-header p {
        font-size: 18px;
        opacity: 0.9;
    }
    
    .products-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }
    
    .category-filter {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-bottom: 40px;
        flex-wrap: wrap;
    }
    
    .filter-btn {
        padding: 12px 25px;
        border: 2px solid #5ccdbe;
        background: white;
        color: #5ccdbe;
        border-radius: 30px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s;
    }
    
    .filter-btn:hover, .filter-btn.active {
        background: #5ccdbe;
        color: white;
    }
    
    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
    }
    
    .product-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        transition: transform 0.3s, box-shadow 0.3s;
    }
    
    .product-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
    }
    
    .product-image {
        width: 100%;
        height: 250px;
        object-fit: cover;
    }
    
    .product-info {
        padding: 20px;
    }
    
    .product-category {
        display: inline-block;
        background: rgba(92, 205, 190, 0.1);
        color: #5ccdbe;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 10px;
    }
    
    .product-name {
        font-size: 20px;
        color: #333;
        margin-bottom: 10px;
        font-weight: 600;
    }
    
    .product-description {
        color: #666;
        font-size: 14px;
        margin-bottom: 15px;
        line-height: 1.6;
    }
    
    .product-price {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 15px;
    }
    
    .current-price {
        font-size: 24px;
        font-weight: 700;
        color: #5ccdbe;
    }
    
    .btn-buy {
        flex: 1;
        padding: 12px 20px;
        background: #5ccdbe;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.3s;
    }
    
    .btn-buy:hover {
        background: #4ab8a9;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 40px;
    }
    
    .pagination button {
        padding: 10px 20px;
        border: 2px solid #5ccdbe;
        background: white;
        color: #5ccdbe;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s;
    }
    
    .pagination button:hover, .pagination button.active {
        background: #5ccdbe;
        color: white;
    }
    
    .pagination button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .price-filter {
        display: flex;
        gap: 15px;
        align-items: center;
        margin-bottom: 20px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .price-filter input {
        padding: 10px 15px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        width: 120px;
    }

    .price-filter button {
        padding: 10px 25px;
        background: #1a3a3a;
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
    }

    .loading {
        text-align: center;
        padding: 60px 20px;
        color: #666;
    }

    .loading-spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #f3f3f3;
        border-top: 4px solid #5ccdbe;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<!-- Products Header -->
<div class="products-header">
    <h1>�� Our Products</h1>
    <p>Quality dental care products for your healthy smile</p>
</div>

<div class="products-page">
    <div class="products-container">
        <!-- Category Filter -->
        <div class="category-filter">
            <button class="filter-btn active" data-category="all">All Products</button>
            <button class="filter-btn" data-category="Dental Products">Dental Products</button>
            <button class="filter-btn" data-category="Oral Care">Oral Care</button>
            <button class="filter-btn" data-category="Whitening">Whitening</button>
            <button class="filter-btn" data-category="Accessories">Accessories</button>
        </div>

        <!-- Price Filter -->
        <div class="price-filter">
            <label>Min Price: $</label>
            <input type="number" id="minPrice" placeholder="0" min="0">
            <label>Max Price: $</label>
            <input type="number" id="maxPrice" placeholder="100" min="0">
            <button id="applyPriceFilter">Apply Filter</button>
        </div>

        <!-- Products Grid -->
        <div class="products-grid" id="productsGrid">
            <div class="loading">
                <div class="loading-spinner"></div>
                <p>Loading products...</p>
            </div>
        </div>

        <!-- Pagination -->
        <div class="pagination" id="pagination"></div>
    </div>
</div>

<%- include('../partials/footer') %>

<script>
    let currentPage = 1;
    let currentCategory = 'all';
    let minPrice = '';
    let maxPrice = '';
    const limit = 6;

    // Fetch products from API
    async function fetchProducts() {
        const productsGrid = document.getElementById('productsGrid');
        productsGrid.innerHTML = '<div class="loading"><div class="loading-spinner"></div><p>Loading products...</p></div>';

        let url = `/api/products?page=${currentPage}&limit=${limit}`;
        
        if (currentCategory !== 'all') {
            url += `&category=${encodeURIComponent(currentCategory)}`;
        }
        if (minPrice) {
            url += `&minPrice=${minPrice}`;
        }
        if (maxPrice) {
            url += `&maxPrice=${maxPrice}`;
        }

        try {
            const response = await fetch(url);
            const data = await response.json();

            if (data.success) {
                renderProducts(data.products);
                renderPagination(data.pagination);
            } else {
                productsGrid.innerHTML = '<p class="loading">Error loading products</p>';
            }
        } catch (error) {
            console.error('Error:', error);
            productsGrid.innerHTML = '<p class="loading">Error loading products</p>';
        }
    }

    // Render products
    function renderProducts(products) {
        const productsGrid = document.getElementById('productsGrid');
        
        if (products.length === 0) {
            productsGrid.innerHTML = '<p class="loading">No products found</p>';
            return;
        }

        productsGrid.innerHTML = products.map(product => `
            <div class="product-card">
                <img src="${product.image || '/images/placeholder.png'}" alt="${product.name}" class="product-image">
                <div class="product-info">
                    <span class="product-category">${product.category}</span>
                    <h3 class="product-name">${product.name}</h3>
                    <p class="product-description">${product.description ? product.description.substring(0, 80) + '...' : ''}</p>
                    <div class="product-price">
                        <span class="current-price">$${product.price.toFixed(2)}</span>
                    </div>
                    <button class="btn-buy" onclick="buyProduct('${product._id}')">Buy Now</button>
                </div>
            </div>
        `).join('');
    }

    // Render pagination
    function renderPagination(pagination) {
        const paginationDiv = document.getElementById('pagination');
        
        if (!pagination || pagination.totalPages <= 1) {
            paginationDiv.innerHTML = '';
            return;
        }

        let html = '';
        
        // Previous button
        html += `<button ${pagination.currentPage === 1 ? 'disabled' : ''} onclick="goToPage(${pagination.currentPage - 1})">Previous</button>`;
        
        // Page numbers
        for (let i = 1; i <= pagination.totalPages; i++) {
            html += `<button class="${i === pagination.currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
        }
        
        // Next button
        html += `<button ${pagination.currentPage === pagination.totalPages ? 'disabled' : ''} onclick="goToPage(${pagination.currentPage + 1})">Next</button>`;
        
        paginationDiv.innerHTML = html;
    }

    // Go to page
    function goToPage(page) {
        currentPage = page;
        fetchProducts();
    }

    // Filter by category
    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentCategory = btn.dataset.category;
            currentPage = 1;
            fetchProducts();
        });
    });

    // Apply price filter
    document.getElementById('applyPriceFilter').addEventListener('click', () => {
        minPrice = document.getElementById('minPrice').value;
        maxPrice = document.getElementById('maxPrice').value;
        currentPage = 1;
        fetchProducts();
    });

    // Buy product
    function buyProduct(productId) {
        window.location.href = `/checkout?product=${productId}`;
    }

    // Initial load
    fetchProducts();
</script>



